<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DinoBonesAP</AssemblyName>
    <RootNamespace>DinoBonesAP</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS0414;NU1701;MSB3277</NoWarn>
    <!-- Override with: dotnet build -p:GameDir="D:\Games\DinoBones\" -->
    <GameDir Condition="'$(GameDir)' == ''">$(MSBuildThisFileDirectory)..\..\DinoBones Tidy Up the Museum\</GameDir>
    <ManagedDir>$(GameDir)DinoBones_Data\Managed\</ManagedDir>
    <ReleaseDir Condition="'$(ReleaseDir)' == ''">$(MSBuildThisFileDirectory)..\..\release\</ReleaseDir>
  </PropertyGroup>

  <!-- Compile against the GAME's own mscorlib/System so any BCL member the game build stripped is a
       compile error here instead of a MissingMethodException at runtime. -->
  <PropertyGroup>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <NoStdLib>true</NoStdLib>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <FrameworkPathOverride>$(ManagedDir)</FrameworkPathOverride>
  </PropertyGroup>

  <ItemGroup>
    <!-- Mono.Cecil 0.10.4 (net40) ships next to DinoBonesAP.dll in Managed; it runs on the game's Mono. -->
    <PackageReference Include="Mono.Cecil" Version="0.10.4" />
    <!-- Our own files and the woven copies live in Managed too once installed: never compile against them. -->
    <Reference Include="$(ManagedDir)*.dll" Exclude="$(ManagedDir)DinoBonesAP.dll;$(ManagedDir)*.AP.dll;$(ManagedDir)Mono.Cecil*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopyToRelease" AfterTargets="Build">
    <MakeDir Directories="$(ReleaseDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ReleaseDir)" />
    <Copy SourceFiles="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)%(Extension)' == 'Mono.Cecil.dll'" DestinationFolder="$(ReleaseDir)" />
  </Target>

</Project>
